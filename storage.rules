rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Sponsor brand images (admin uploads)
    match /quizzes/sponsor_brands/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    // 50Above50 contest submissions
    match /contests/{contestId}/submissions/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    // Medical documents (user's own)
    match /users/{userId}/medical_docs/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Memory Lane photos (user's own)
    match /users/{userId}/memories/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
